NODE_ENV=development
PORT=3002

DATABASE_URL=postgresql://user:password@localhost:5432/smart_budget
# auto (default): honour ?sslmode= in the URL, else off for localhost, on elsewhere.
# Set to `disable` for a Docker Compose service name or any host without TLS.
DATABASE_SSL=auto

# Each must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<generate-a-long-random-hex-string>
JWT_REFRESH_SECRET=<generate-a-long-random-hex-string>
CSRF_SECRET=<generate-a-long-random-hex-string>

CLIENT_URL=https://your-frontend-url.vercel.app

# Optional. When set, `npm test` also runs the database-backed suites against
# this database (it is truncated on every run — never point it at real data).
# TEST_DATABASE_URL=postgresql://test:test@localhost:5432/smart_budget_test
